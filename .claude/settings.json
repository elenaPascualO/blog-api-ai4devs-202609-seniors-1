{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-prompt.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 150,
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-outcome.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "/Users/elena.pascual.ext/Development/PERSONAL/LIDR/blog/blog-api/.claude/hooks/marcador.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/statusline.sh"
  }
}
